#!/bin/bash

# Dotfiles Installation Script
# Creates symlinks from this repo to standard config locations

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the directory where this script is located
DOTFILES_DIR="$(cd "$(dirname "$0")" && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup-$(date +%Y%m%d-%H%M%S)"

# Helper functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Backup existing file or directory
backup_if_exists() {
    local target="$1"
    if [ -e "$target" ] || [ -L "$target" ]; then
        if [ ! -d "$BACKUP_DIR" ]; then
            mkdir -p "$BACKUP_DIR"
            print_info "Created backup directory: $BACKUP_DIR"
        fi
        local backup_path="$BACKUP_DIR/$(basename "$target")"
        mv "$target" "$backup_path"
        print_warning "Backed up existing $(basename "$target") to $backup_path"
    fi
}

# Create symlink with backup
create_symlink() {
    local source="$1"
    local target="$2"
    local description="$3"
    
    if [ ! -e "$source" ]; then
        print_warning "Skipping $description - source not found: $source"
        return
    fi
    
    # Ensure parent directory exists
    local parent_dir="$(dirname "$target")"
    if [ ! -d "$parent_dir" ]; then
        mkdir -p "$parent_dir"
        print_info "Created directory: $parent_dir"
    fi
    
    # Backup existing file/directory
    backup_if_exists "$target"
    
    # Create symlink
    ln -sf "$source" "$target"
    print_success "Linked $description: $target -> $source"
}

# Main installation
print_info "Starting dotfiles installation from: $DOTFILES_DIR"
echo ""

# Ensure we're in the dotfiles directory
cd "$DOTFILES_DIR"

# Install alacritty config
print_info "Installing alacritty configuration..."
create_symlink "$DOTFILES_DIR/alacritty" "$HOME/.config/alacritty" "alacritty config"
echo ""

# Install ghostty config
print_info "Installing ghostty configuration..."
create_symlink "$DOTFILES_DIR/ghostty" "$HOME/.config/ghostty" "ghostty config"
echo ""

# Install nix config
print_info "Installing nix configuration..."
create_symlink "$DOTFILES_DIR/nix/nix.conf" "$HOME/.config/nix/nix.conf" "nix config"
echo ""

# Install fish config
print_info "Installing fish configuration..."
create_symlink "$DOTFILES_DIR/fish/config.fish" "$HOME/.config/fish/config.fish" "fish config.fish"
create_symlink "$DOTFILES_DIR/fish/conf.d" "$HOME/.config/fish/conf.d" "fish conf.d"
create_symlink "$DOTFILES_DIR/fish/functions" "$HOME/.config/fish/functions" "fish functions"
echo ""

# Install and configure fish as default shell
print_info "Setting up fish shell..."
if command -v fish > /dev/null 2>&1; then
    print_info "fish already installed at $(command -v fish)"
elif command -v nix-env > /dev/null 2>&1; then
    print_info "Installing fish via nix..."
    nix-env -iA nixpkgs.fish
    print_success "Installed fish via nix"
elif [ "$(uname)" = "Linux" ] && command -v apt > /dev/null 2>&1; then
    print_info "Installing fish via apt..."
    sudo apt install -y fish
    print_success "Installed fish via apt"
elif [ "$(uname)" = "Linux" ] && command -v dnf > /dev/null 2>&1; then
    print_info "Installing fish via dnf..."
    sudo dnf install -y fish
    print_success "Installed fish via dnf"
elif [ "$(uname)" = "Linux" ] && command -v pacman > /dev/null 2>&1; then
    print_info "Installing fish via pacman..."
    sudo pacman -S --noconfirm fish
    print_success "Installed fish via pacman"
elif command -v brew > /dev/null 2>&1; then
    print_info "Installing fish via brew..."
    brew install fish
    print_success "Installed fish via brew"
else
    print_warning "Could not install fish: no supported package manager found"
fi

if command -v fish > /dev/null 2>&1; then
    FISH_PATH="$(command -v fish)"
    if grep -qF "$FISH_PATH" /etc/shells; then
        print_info "fish already in /etc/shells"
    else
        echo "$FISH_PATH" | sudo tee -a /etc/shells > /dev/null
        print_success "Added $FISH_PATH to /etc/shells"
    fi
    if [ "$SHELL" = "$FISH_PATH" ]; then
        print_info "fish is already the default shell"
    else
        chsh -s "$FISH_PATH"
        print_success "Set default shell to $FISH_PATH"
    fi
fi
echo ""

# Install fnm (Fast Node Manager)
print_info "Setting up fnm (Fast Node Manager)..."
if command -v fnm > /dev/null 2>&1; then
    print_info "fnm already installed at $(command -v fnm)"
elif command -v nix-env > /dev/null 2>&1; then
    print_info "Installing fnm via nix..."
    nix-env -iA nixpkgs.fnm
    print_success "Installed fnm via nix"
elif [ "$(uname)" = "Linux" ]; then
    print_info "Installing fnm via curl installer..."
    curl -fsSL https://fnm.vercel.app/install | bash -s -- --install-dir "$HOME/.local/bin" --skip-shell
    print_success "Installed fnm via curl"
elif command -v brew > /dev/null 2>&1; then
    print_info "Installing fnm via brew..."
    brew install fnm
    print_success "Installed fnm via brew"
else
    print_warning "Could not install fnm: no supported package manager found"
fi
echo ""

# Install tmux config
print_info "Installing tmux configuration..."
create_symlink "$DOTFILES_DIR/tmux/.tmux.conf" "$HOME/.tmux.conf" "tmux config"
create_symlink "$DOTFILES_DIR/tmux" "$HOME/.config/tmux" "tmux config directory"
echo ""

# Install vim
print_info "Installing vim configuration..."
if [ -d "$HOME/.vim" ]; then
    print_warning "Vim directory already exists at $HOME/.vim - skipping clone"
else
    git clone --recurse-submodules https://github.com/bspaulding/.vim.git "$HOME/.vim"
    print_success "Cloned vim configuration"
    if [ -f "$HOME/.vim/install" ]; then
        sh "$HOME/.vim/install"
        print_success "Ran vim install script"
    fi
fi
echo ""

print_success "=========================================="
print_success "Dotfiles installation complete!"
print_success "=========================================="
if [ -d "$BACKUP_DIR" ]; then
    echo ""
    print_info "Previous configurations backed up to: $BACKUP_DIR"
fi
