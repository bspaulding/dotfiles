#!/bin/bash

# Dotfiles Restore Script
# Restores dotfiles from a backup directory

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helper functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if backup directory is provided
if [ -z "$1" ]; then
    print_error "Usage: $0 <backup-directory>"
    echo ""
    print_info "Available backups:"
    ls -1dt ~/.dotfiles-backup-* 2>/dev/null | head -5 || echo "  No backups found"
    exit 1
fi

BACKUP_DIR="$1"

# Validate backup directory exists
if [ ! -d "$BACKUP_DIR" ]; then
    print_error "Backup directory not found: $BACKUP_DIR"
    exit 1
fi

print_warning "This will restore configs from: $BACKUP_DIR"
print_warning "Current symlinks will be removed and replaced with the backed up files."
echo ""
read -p "Are you sure you want to continue? (y/N) " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    print_info "Restore cancelled"
    exit 0
fi

echo ""
print_info "Starting restore from: $BACKUP_DIR"
echo ""

# Restore each config if it exists in backup
restore_config() {
    local backup_item="$1"
    local target="$2"
    local description="$3"
    
    if [ ! -e "$backup_item" ]; then
        print_warning "Skipping $description - not found in backup"
        return
    fi
    
    # Remove current symlink or file
    if [ -e "$target" ] || [ -L "$target" ]; then
        rm -rf "$target"
        print_info "Removed current $description"
    fi
    
    # Restore from backup
    cp -r "$backup_item" "$target"
    print_success "Restored $description"
}

# Restore alacritty
if [ -e "$BACKUP_DIR/alacritty" ]; then
    print_info "Restoring alacritty configuration..."
    restore_config "$BACKUP_DIR/alacritty" "$HOME/.config/alacritty" "alacritty config"
    echo ""
fi

# Restore fish configs
print_info "Restoring fish configuration..."
restore_config "$BACKUP_DIR/config.fish" "$HOME/.config/fish/config.fish" "fish config.fish"
restore_config "$BACKUP_DIR/conf.d" "$HOME/.config/fish/conf.d" "fish conf.d"
restore_config "$BACKUP_DIR/functions" "$HOME/.config/fish/functions" "fish functions"
echo ""

# Restore tmux configs
print_info "Restoring tmux configuration..."
restore_config "$BACKUP_DIR/.tmux.conf" "$HOME/.tmux.conf" "tmux config"
restore_config "$BACKUP_DIR/tmux" "$HOME/.config/tmux" "tmux config directory"
echo ""

print_success "=========================================="
print_success "Restore complete!"
print_success "=========================================="
print_info "Your dotfiles have been restored from the backup."
print_info "You can re-run ./install to set up symlinks again if needed."
