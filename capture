#!/bin/bash

# Dotfiles Capture Script
# Copies current config files from home directory into this repo

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the directory where this script is located
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Helper functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Capture file or directory
capture_config() {
    local source="$1"
    local dest="$2"
    local description="$3"
    
    if [ ! -e "$source" ]; then
        print_warning "Skipping $description - not found: $source"
        return
    fi
    
    # Create parent directory if needed
    local parent_dir="$(dirname "$dest")"
    if [ ! -d "$parent_dir" ]; then
        mkdir -p "$parent_dir"
    fi
    
    # Copy the config
    if [ -d "$source" ]; then
        cp -r "$source" "$dest"
    else
        cp "$source" "$dest"
    fi
    
    print_success "Captured $description: $source -> $dest"
}

print_info "Capturing dotfiles from home directory to: $DOTFILES_DIR"
echo ""

cd "$DOTFILES_DIR"

# Check if configs are already symlinked (install already run)
print_info "Checking for existing symlinks..."
SYMLINKS_FOUND=0

check_symlink() {
    local target="$1"
    local description="$2"
    
    if [ -L "$target" ]; then
        local link_target="$(readlink "$target")"
        if [[ "$link_target" == "$DOTFILES_DIR"* ]]; then
            print_error "Found symlink: $target -> $link_target"
            SYMLINKS_FOUND=1
        fi
    fi
}

check_symlink "$HOME/.config/nix/nix.conf" "nix config"
check_symlink "$HOME/.config/alacritty" "alacritty"
check_symlink "$HOME/.config/fish/config.fish" "fish config.fish"
check_symlink "$HOME/.config/fish/conf.d" "fish conf.d"
check_symlink "$HOME/.config/fish/functions" "fish functions"
check_symlink "$HOME/.tmux.conf" "tmux config"
check_symlink "$HOME/.config/tmux" "tmux config directory"

if [ $SYMLINKS_FOUND -eq 1 ]; then
    echo ""
    print_error "=========================================="
    print_error "Cannot capture configs!"
    print_error "=========================================="
    print_error "Detected existing symlinks pointing to this repo."
    print_error "The install script has already been run."
    echo ""
    print_info "To capture configs, you must first restore from backup:"
    print_info "  ./restore <backup-directory>"
    echo ""
    print_info "Or manually remove symlinks and copy files back:"
    print_info "  rm ~/.config/alacritty ~/.config/fish/config.fish ..."
    print_info "  cp -r /path/to/backup/* ~/"
    exit 1
fi

print_success "No symlinks detected - safe to capture"
echo ""

# Capture nix config
print_info "Capturing nix configuration..."
capture_config "$HOME/.config/nix/nix.conf" "$DOTFILES_DIR/nix/nix.conf" "nix config"
echo ""

# Capture alacritty config
print_info "Capturing alacritty configuration..."
capture_config "$HOME/.config/alacritty" "$DOTFILES_DIR/alacritty" "alacritty config"
echo ""

# Capture fish config
print_info "Capturing fish configuration..."
capture_config "$HOME/.config/fish/config.fish" "$DOTFILES_DIR/fish/config.fish" "fish config.fish"
capture_config "$HOME/.config/fish/conf.d" "$DOTFILES_DIR/fish/conf.d" "fish conf.d"
capture_config "$HOME/.config/fish/functions" "$DOTFILES_DIR/fish/functions" "fish functions"
echo ""

# Capture tmux config
print_info "Capturing tmux configuration..."
capture_config "$HOME/.tmux.conf" "$DOTFILES_DIR/tmux/.tmux.conf" "tmux config"
# Capture additional tmux configs but not the main .tmux.conf again
if [ -d "$HOME/.config/tmux" ]; then
    for file in "$HOME/.config/tmux"/*; do
        if [ -f "$file" ] && [ "$(basename "$file")" != ".tmux.conf" ]; then
            capture_config "$file" "$DOTFILES_DIR/tmux/$(basename "$file")" "tmux $(basename "$file")"
        fi
    done
fi
echo ""

print_success "=========================================="
print_success "Dotfiles capture complete!"
print_success "=========================================="
print_info "Review changes with: git status"
print_info "Commit changes with: git add . && git commit -m 'Update dotfiles'"
